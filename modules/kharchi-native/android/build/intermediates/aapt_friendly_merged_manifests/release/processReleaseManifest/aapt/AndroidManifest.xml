<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="expo.modules.kharchinative" >

    <uses-sdk android:minSdkVersion="26" />
    <!--
    Components that are safe in BOTH variants live here (tile, widget, notification action receiver).
    SMS receiver, notification listener and the experimental double-tap service are added by
    plugins/withKharchiNative.js only when APP_VARIANT=full.
    -->
    <application>
        <receiver
            android:name="expo.modules.kharchinative.ActionReceiver"
            android:exported="false" />

        <service
            android:name="expo.modules.kharchinative.QuickAddTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_add"
            android:label="Add expense"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" >
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name="expo.modules.kharchinative.QuickAddWidgetProvider"
            android:exported="true"
            android:label="Add expense" >
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kharchi_widget_info" />
        </receiver>
        <receiver
            android:name="expo.modules.kharchinative.BootReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>